#[test] fun ten_ticks_match_the_reference() {
    let mut ctx = tx_context::dummy();
    let c = conn(&mut ctx);
    let mut clock = clock::create_for_testing(&mut ctx);
    let mut larva = ciona::hatch_with_genome(neutral(), &clock, &c, &mut ctx);
    assert!(ciona::stage_of(&larva) == 1, 1);
    let mut i = 0;
    while (i < 10) {
        clock::increment_for_testing(&mut clock, 1);
        ciona::swim(&mut larva, &c, &clock, 1500, 0, 256, false, false);
        i = i + 1;
    };
    assert!(ciona::x_of(&larva) == 1000138, 2);
    assert!(ciona::y_of(&larva) == 999998, 3);
    assert!(ciona::heading_of(&larva) == 65532, 4);
    assert!(ciona::yolk_of(&larva) == 99828, 5);
    assert!(ciona::tick_of(&larva) == 10, 6);
    assert!(ciona::hash_of(&larva) == vector[201u8,208u8,145u8,195u8,235u8,125u8,90u8,215u8,210u8,239u8,39u8,155u8,97u8,243u8,195u8,211u8,27u8,5u8,157u8,204u8,14u8,96u8,209u8,245u8,227u8,127u8,68u8,185u8,56u8,246u8,29u8,71u8], 7);
    clock::destroy_for_testing(clock);
    ciona::destroy_ciona(larva);
    brain::destroy_connectome(c);
}

